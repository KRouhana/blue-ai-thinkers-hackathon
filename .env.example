# D defaults to an explicitly labeled, offline fixture workspace.
FORK_MODE=fixture
# B's control API (packages/orchestrator + apps/api). Server-side values; never VITE_ secrets.
FORK_API_BASE=http://127.0.0.1:8787
FORK_PROJECT_CONFIG_ID=demo-product
FORK_PROJECT_MODE=existing_repo
# Exact preview origin registered by C. No wildcard origin is accepted.
FORK_PREVIEW_ORIGIN=http://127.0.0.1:4173
# Optional absolute path to A's adapter module (see docs/INTEGRATION.md).
FORK_PERCEPTION_MODULE=
# Live launcher only: existing teammate npm workspace names, if available.
FORK_API_WORKSPACE=api
FORK_PREVIEW_WORKSPACE=
# Managed CopilotKit Channels; setup requires the team's account.
CHANNEL_CODE=
INTELLIGENCE_API_KEY=
FORK_SLACK_HOST_IDS=
FORK_SLACK_ENABLED=false
FORK_MEETING_URL=http://127.0.0.1:3000
FORK_CHANNEL_PORT=3001
# Google Meet bot join (apps/meet-bot), via Recall.ai's meeting-bot API.
# Needs a Recall.ai account/API key and a public tunnel URL for the presenter view;
# Recall's cloud bot cannot reach 127.0.0.1. See apps/meet-bot/README.md.
RECALL_API_KEY=
RECALL_REGION=us-east-1

# ── MODEL PROVIDER (same names as the CopilotKit starter) ──────────────────
MODEL_PROVIDER=openai
OPENAI_API_KEY=stub-replace-me
MODEL=gpt-5.6-sol
# OPENROUTER_API_KEY=
# MODEL=openai/gpt-5.6-sol

# ── FORK TRACK B: local control API ────────────────────────────────────────
FORK_API_HOST=127.0.0.1
FORK_API_PORT=8787
# Shared secret for D/A/C local clients. If unset, a random token is generated and printed once at boot.
FORK_API_TOKEN=
# Browser origins allowed to call the API (meeting shell). Comma separated.
FORK_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SQLite path (":memory:" for ephemeral). Relative paths resolve from the repo root; directory is created if missing.
FORK_DB_PATH=./.data/fork.sqlite
# fixture = labeled replay planner (no model calls). live = real model via MODEL_PROVIDER.
FORK_PLANNER=fixture
# fake = labeled in-memory engine. live = C's adapter (wired by D once available).
FORK_ENGINE=fake
FORK_SETTLE_MS=1200
FORK_PROJECTS_FILE=./fork.projects.json
FORK_COMPANY_DOCS_DIR=./fixtures/company
