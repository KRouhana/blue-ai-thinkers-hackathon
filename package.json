{
  "name": "fork-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fork Track D: meeting workspace and Slack integration",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/meeting",
    "apps/channel",
    "apps/meet-bot"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:meeting": "npm run dev --workspace meeting",
    "dev:slack": "npm run dev --workspace channel",
    "meetbot": "npm run start --workspace meet-bot --",
    "channel:setup": "npx copilotkit@latest channels setup",
    "channel:status": "npx copilotkit@latest channels status --json",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test apps/meeting/src/integration/*.test.ts apps/channel/src/*.test.tsx",
    "build": "npm run build --workspace meeting",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "overrides": {
    "@ag-ui/client": "0.0.59"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
