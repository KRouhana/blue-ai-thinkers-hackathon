{
  "name": "@fork/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fork v2 contextual planner, deterministic gate, and single-writer scheduler. Owned by Track B.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
