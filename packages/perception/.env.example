# Server-side only. Do not expose either secret to a browser bundle.
OPENROUTER_API_KEY=
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-transcribe
RECALL_WORKSPACE_VERIFICATION_SECRET=
RECALL_REGION=us-east-1

# A stable, publicly reachable HTTPS ngrok URL. The receiver derives WSS from it.
PUBLIC_API_BASE_URL=https://your-static-subdomain.ngrok.app
PERCEPTION_PORT=4318
