{
  "name": "@fork/perception",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Silent Google Meet audio and preview-context capture for Fork Track A.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": ["dist", "README.md", ".env.example"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "node --env-file=.env dist/demo-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/ws": "^8.5.14",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
